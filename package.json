{
  "name": "t3code-local",
  "version": "0.1.1",
  "private": true,
  "description": "A local-only T3 Code fork for an existing approved Codex CLI",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.10 <25"
  },
  "scripts": {
    "build": "vite build --config minimal/vite.config.ts && node scripts/licenses.mjs",
    "start": "node minimal/server/main.mjs",
    "test": "node --test minimal/test/*.test.mjs",
    "test:e2e": "playwright test --config minimal/playwright.config.ts",
    "package": "node scripts/package.mjs",
    "verify:release": "node scripts/smoke-release.mjs",
    "typecheck": "tsc --noEmit --jsx react-jsx --module ESNext --moduleResolution Bundler --target ES2022 --lib ES2023,DOM --types vite/client --skipLibCheck --strict minimal/web/src/main.tsx",
    "test:compose": "node scripts/smoke-compose.mjs"
  },
  "devDependencies": {
    "@base-ui/react": "1.5.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "class-variance-authority": "0.7.1",
    "lucide-react": "0.564.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "vite": "8.3.5"
  }
}
